# Ollama's OpenAI-compatible API. Keep Ollama running in a separate terminal.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:7b

# Brave Search is the agent's only tool. Create a key at https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_COUNTRY=IN
BRAVE_SEARCH_LANGUAGE=en

# Optional absolute path. Defaults to ./data/daymark.sqlite.
# DATABASE_PATH=
